# Produkcja — SAMtrening CRM.
#
# Ten plik jest wzorem, nie konfiguracją: sekrety wpisuje się w panelu Forge
# (Site → Environment), nigdy do repozytorium. Wartości oznaczone „→ WPISZ"
# są do uzupełnienia przy wdrożeniu.

APP_NAME="SAMtrening CRM"
APP_ENV=production
APP_KEY=                          # → WPISZ: php artisan key:generate --show, potem trzymaj kopię OSOBNO (SC-52)
APP_DEBUG=false
APP_URL=https://crm.samtrening.com  # → WPISZ docelową domenę

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL
APP_TIMEZONE=Europe/Warsaw        # tydzień, monity i próg ciszy liczą się w tej strefie

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                 # na produkcji debug zapisywałby dane klientów do pliku

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=samtrening
DB_USERNAME=forge
DB_PASSWORD=                      # → WPISZ (Forge generuje przy tworzeniu bazy)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true              # w sesji siedzą dane zalogowanego trenera
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true        # HTTPS jest wymagane, więc ciasteczko też

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local             # plany klientów NIGDY na dysku publicznym
QUEUE_CONNECTION=database         # wysyłka SMS i e-maili; worker pod nadzorem Forge

CACHE_STORE=database

# Poczta — SC-17. Gmail API po HTTPS.
#
# Nie SMTP: DigitalOcean blokuje wychodzące porty 25, 465 i 587 na wszystkich
# dropletach, więc smtp-relay.gmail.com jest z serwera aplikacji nieosiągalny.
# Uwierzytelniamy się tokenem odświeżania jednej skrzynki Workspace — bez konta
# usługowego i bez delegacji domenowej, żeby uprawnienie kończyło się na niej.
MAIL_MAILER=gmail
MAIL_FROM_ADDRESS="maciej.samborski@samtrening.com"
MAIL_FROM_NAME="SAMtrening"

GMAIL_CLIENT_ID=                  # → WPISZ: klient OAuth typu Aplikacja internetowa (Google Cloud)
GMAIL_CLIENT_SECRET=              # → WPISZ
GMAIL_REFRESH_TOKEN=              # → WPISZ: wynik php artisan gmail:authorize

# SMS — SC-16. SMSAPI, model prepaid. „log" zostaje dla maszyny deweloperskiej.
SMS_PROVIDER=smsapi
SMS_SENDER=SAMtrening             # nazwa zatwierdzona przez operatora, max 11 znaków
SMS_API_TOKEN=                    # → WPISZ token OAuth z panelu SMSAPI (Forge, nie repo)

OWNER_NAME="Maciej Samborski"
OWNER_EMAIL=maciek@samtrening.com
OWNER_PASSWORD=                   # → WPISZ jednorazowo do pierwszego seeda, potem usuń z Forge
OWNER_PHONE="+48 728 385 203"     # kontakt na ekranie logowania — pusty znika

VITE_APP_NAME="${APP_NAME}"
